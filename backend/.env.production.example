# ==============================================================================
# LAMPUNG REPORT — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Binding
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
APP_ENV=production

# Database Connection (Managed PostgreSQL: Neon / Supabase / Railway / Self-Hosted)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgres://lampung_admin:YourStrongPasswordHere@your-pg-host.railway.app:5432/lampung_report_prod?sslmode=require

# Authentication & Cryptographic Secrets
# Generate using: openssl rand -base64 48
JWT_SECRET=generate-a-secure-random-64-character-secret-key-here
JWT_EXPIRATION_HOURS=24

# File Upload Storage
UPLOAD_DIR=/app/uploads

# Network & CORS Security
# Comma-separated list of allowed frontend origins (no wildcard in production!)
ALLOWED_ORIGINS=https://lampung-report.vercel.app,https://lapor.bandarlampung.go.id

